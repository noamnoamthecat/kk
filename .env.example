# Copy to .env and fill in only the providers you use. Never commit .env.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true          # set to false ONLY when you mean to trade real money
ALPACA_DATA_FEED=iex       # sip on a paid Alpaca data plan
POLYGON_API_KEY=
TIINGO_API_KEY=
FMP_API_KEY=
ALPHAVANTAGE_API_KEY=
TWELVEDATA_API_KEY=
EODHD_API_KEY=
BLP_HOST=localhost
BLP_PORT=8194

# --- web app / live engine ---
REGIMEML_MODE=replay       # replay (simulated demo) | live (real market data)
REGIMEML_PROVIDER=yahoo    # data provider used in live mode
REGIMEML_TICKERS=          # comma-separated; default = 50 US large caps
REGIMEML_TOKEN=            # dashboard password (?token=...); required for e-mail sign-ups
REGIMEML_STATE_DIR=state   # track record + subscribers persist here
REGIMEML_AUTOTRADE=false   # true = rebalance via Alpaca 10 min before the close (paper unless ALPACA_PAPER=false)
REGIMEML_LONG_ONLY=false

# --- daily e-mail (any SMTP: Gmail app password, SendGrid, Mailgun, SES, Postmark) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
